# Copy this file to .env and fill in your values. Never commit .env.
# API key and secret: https://api.icicidirect.com/apiuser/home -> View Apps
BREEZE_API_KEY=
BREEZE_API_SECRET=
# Changes every day. Get it with: python login_url.py  (then copy apisession=... from the address bar)
# Leave empty to be prompted when a script starts.
BREEZE_SESSION=
